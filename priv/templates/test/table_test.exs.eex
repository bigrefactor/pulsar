defmodule <%= @component_namespace %>.TableTest do
  use ExUnit.Case, async: true

  import Phoenix.LiveViewTest
  import Phoenix.Component

  alias <%= @component_namespace %>.Table

  # `table` requires a `rows` list and one or more `:col` slots, each with a
  # required `label` attr and `:let`-bound cell content, so the smoke test
  # supplies sample rows and columns rather than relying on introspection.
  defp rows do
    [
      %{id: 1, name: "Jane", email: "jane@example.com"},
      %{id: 2, name: "John", email: "john@example.com"}
    ]
  end

  describe "table/1" do
    test "renders a table with headers and row cells" do
      assigns = %{rows: rows()}

      html =
        rendered_to_string(~H"""
        <Table.table id="people" rows={@rows} aria_label="People">
          <:col :let={row} label="Name">{row.name}</:col>
          <:col :let={row} label="Email">{row.email}</:col>
        </Table.table>
        """)

      assert html =~ "<table"
      assert html =~ "<th"
      assert html =~ "Name"
      assert html =~ "Email"
      assert html =~ "Jane"
      assert html =~ "jane@example.com"
    end

    test "renders every variant" do
      for variant <- ~w(solid outline ghost) do
        assigns = %{rows: rows(), variant: variant}

        html =
          rendered_to_string(~H"""
          <Table.table id="people" rows={@rows} variant={@variant} aria_label="People">
            <:col :let={row} label="Name">{row.name}</:col>
          </Table.table>
          """)

        assert html =~ "<table"
        assert html =~ "Jane"
      end
    end

    test "renders every color" do
      for color <- ~w(neutral primary secondary success danger warning info) do
        assigns = %{rows: rows(), color: color}

        html =
          rendered_to_string(~H"""
          <Table.table id="people" rows={@rows} color={@color} aria_label="People">
            <:col :let={row} label="Name">{row.name}</:col>
          </Table.table>
          """)

        assert html =~ "<table"
      end
    end

    test "renders every size" do
      for size <- ~w(xs sm md lg xl) do
        assigns = %{rows: rows(), size: size}

        html =
          rendered_to_string(~H"""
          <Table.table id="people" rows={@rows} size={@size} aria_label="People">
            <:col :let={row} label="Name">{row.name}</:col>
          </Table.table>
          """)

        assert html =~ "<table"
      end
    end

    test "renders an action column" do
      assigns = %{rows: rows()}

      html =
        rendered_to_string(~H"""
        <Table.table id="people" rows={@rows} aria_label="People">
          <:col :let={row} label="Name">{row.name}</:col>
          <:action :let={row}>Edit {row.name}</:action>
        </Table.table>
        """)

      assert html =~ "Edit Jane"
    end

    test "renders the empty state when there are no rows" do
      assigns = %{}

      html =
        rendered_to_string(~H"""
        <Table.table id="people" rows={[]} aria_label="People">
          <:col :let={row} label="Name">{row.name}</:col>
          <:empty>Nothing here yet</:empty>
        </Table.table>
        """)

      assert html =~ "Nothing here yet"
    end

    test "a sortable column renders a sort button and its aria-sort state" do
      assigns = %{rows: rows(), on_sort: Phoenix.LiveView.JS.push("sort", value: %{by: "name"})}

      html =
        rendered_to_string(~H"""
        <Table.table id="people" rows={@rows} aria_label="People">
          <:col :let={row} label="Name" sortable sort_direction="ascending" on_sort={@on_sort}>
            {row.name}
          </:col>
        </Table.table>
        """)

      assert html =~ ~s(aria-sort="ascending")
      assert html =~ ~s(<button)
      assert html =~ ~s(type="button")
    end

    test "renders every sort_direction" do
      for direction <- ~w(ascending descending other none) do
        assigns = %{
          rows: rows(),
          direction: direction,
          on_sort: Phoenix.LiveView.JS.push("sort", value: %{by: "name"})
        }

        html =
          rendered_to_string(~H"""
          <Table.table id="people" rows={@rows} aria_label="People">
            <:col :let={row} label="Name" sortable sort_direction={@direction} on_sort={@on_sort}>
              {row.name}
            </:col>
          </Table.table>
          """)

        assert html =~ ~s(aria-sort="#{direction}")
      end
    end

    test "a non-sortable column carries no aria-sort and no sort button" do
      assigns = %{rows: rows()}

      html =
        rendered_to_string(~H"""
        <Table.table id="people" rows={@rows} aria_label="People">
          <:col :let={row} label="Name">{row.name}</:col>
        </Table.table>
        """)

      refute html =~ "aria-sort"
      refute html =~ "<button"
    end

    test "a sortable column without an on_sort action raises" do
      assigns = %{rows: rows()}

      assert_raise ArgumentError, ~r/on_sort/, fn ->
        rendered_to_string(~H"""
        <Table.table id="people" rows={@rows} aria_label="People">
          <:col :let={row} label="Name" sortable>{row.name}</:col>
        </Table.table>
        """)
      end
    end

    test "row_click rows are activatable by keyboard" do
      assigns = %{rows: rows(), row_click: fn row -> Phoenix.LiveView.JS.push("open", value: %{id: row.id}) end}

      html =
        rendered_to_string(~H"""
        <Table.table id="people" rows={@rows} row_click={@row_click} aria_label="People">
          <:col :let={row} label="Name">{row.name}</:col>
        </Table.table>
        """)

      assert html =~ ~s(data-row-click="true")
      assert html =~ ~s(tabindex="0")
      assert html =~ ~s(role="button")
    end

    test "row_id derives a stable row element id" do
      assigns = %{rows: rows(), row_id: fn row -> "person-#{row.id}" end}

      html =
        rendered_to_string(~H"""
        <Table.table id="people" rows={@rows} row_id={@row_id} aria_label="People">
          <:col :let={row} label="Name">{row.name}</:col>
        </Table.table>
        """)

      assert html =~ ~s(id="person-1")
      assert html =~ ~s(id="person-2")
    end

    test "renders loading, striped and sticky_header true and false" do
      for value <- [true, false] do
        assigns = %{rows: rows(), value: value}

        html =
          rendered_to_string(~H"""
          <Table.table
            id="people"
            rows={@rows}
            loading={@value}
            striped={@value}
            sticky_header={@value}
            aria_label="People"
          >
            <:col :let={row} label="Name">{row.name}</:col>
          </Table.table>
          """)

        assert html =~ "<table"
      end
    end
  end
end
