defmodule <%= @component_namespace %>.CheckboxTest do
  use ExUnit.Case, async: true

  import Phoenix.LiveViewTest
  import Phoenix.Component

  alias <%= @component_namespace %>.Checkbox

  # `checkbox` renders its name/checked state from a bound Phoenix form field, so the
  # smoke test supplies one rather than relying on introspection.
  defp form_field do
    Phoenix.Component.to_form(%{"terms" => "true"}, as: :user)[:terms]
  end

  describe "checkbox/1" do
    test "renders a checkbox input bound to a form field" do
      assigns = %{field: form_field()}
      html = rendered_to_string(~H"<Checkbox.checkbox field={@field} />")
      assert html =~ ~s(type="checkbox")
      assert html =~ ~s(name="user[terms]")
    end

    test "renders every color" do
      for color <- ~w(neutral primary secondary success danger warning info) do
        assigns = %{field: form_field(), color: color}
        html = rendered_to_string(~H"<Checkbox.checkbox field={@field} color={@color} />")
        assert html =~ ~s(type="checkbox")
      end
    end

    test "renders every size" do
      for size <- ~w(xs sm md lg xl) do
        assigns = %{field: form_field(), size: size}
        html = rendered_to_string(~H"<Checkbox.checkbox field={@field} size={@size} />")
        assert html =~ ~s(type="checkbox")
      end
    end

    test "renders every variant in card mode" do
      for variant <- ~w(solid outline ghost) do
        assigns = %{field: form_field(), variant: variant}

        html =
          rendered_to_string(
            ~H"<Checkbox.checkbox field={@field} card variant={@variant}>Pulsar</Checkbox.checkbox>"
          )

        assert html =~ ~s(name="user[terms]")
        assert html =~ "Pulsar"
      end
    end

    test "renders disabled, required and invalid true and false" do
      for value <- [true, false] do
        assigns = %{field: form_field(), value: value}

        html =
          rendered_to_string(~H"""
          <Checkbox.checkbox
            field={@field}
            disabled={@value}
            required={@value}
            invalid={@value}
          />
          """)

        assert html =~ ~s(type="checkbox")

        if value do
          assert html =~ "disabled"
          assert html =~ "required"
        end
      end
    end

    test "marks the indeterminate state for assistive tech" do
      for value <- [true, false] do
        assigns = %{field: form_field(), value: value}

        html =
          rendered_to_string(~H"<Checkbox.checkbox field={@field} indeterminate={@value} />")

        if value do
          assert html =~ ~s(data-indeterminate="true")
        else
          refute html =~ "data-indeterminate"
        end
      end
    end

    test "render_hidden emits an unchecked companion input" do
      for value <- [true, false] do
        assigns = %{field: form_field(), value: value}

        html =
          rendered_to_string(~H"<Checkbox.checkbox field={@field} render_hidden={@value} />")

        if value do
          assert html =~ ~s(type="hidden")
        else
          refute html =~ ~s(type="hidden")
        end
      end
    end

    test "an explicit checked attr overrides the bound field in both directions" do
      on = Phoenix.Component.to_form(%{"terms" => "true"}, as: :user)[:terms]
      off = Phoenix.Component.to_form(%{"terms" => "false"}, as: :user)[:terms]

      # Omitted, the state comes from the field.
      assigns = %{field: on}
      assert rendered_to_string(~H"<Checkbox.checkbox field={@field} />") =~ ~r/<input[^>]*\schecked/

      assigns = %{field: off}
      refute rendered_to_string(~H"<Checkbox.checkbox field={@field} />") =~ ~r/<input[^>]*\schecked/

      # Supplied, the caller wins — including an explicit false over a checked field.
      assigns = %{field: on}

      refute rendered_to_string(~H"<Checkbox.checkbox field={@field} checked={false} />") =~
               ~r/<input[^>]*\schecked/

      assigns = %{field: off}

      assert rendered_to_string(~H"<Checkbox.checkbox field={@field} checked={true} />") =~
               ~r/<input[^>]*\schecked/
    end

    test "renders hide_checkbox true and false in card mode" do
      for value <- [true, false] do
        assigns = %{field: form_field(), value: value}

        html =
          rendered_to_string(~H"""
          <Checkbox.checkbox field={@field} card hide_checkbox={@value}>Pulsar</Checkbox.checkbox>
          """)

        assert html =~ ~s(name="user[terms]")
        assert html =~ "Pulsar"
      end
    end
  end
end
