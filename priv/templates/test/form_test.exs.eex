defmodule <%= @component_namespace %>.FormTest do
  use ExUnit.Case, async: true

  import Phoenix.LiveViewTest
  import Phoenix.Component

  alias <%= @component_namespace %>.Form

  # `form` wraps `Phoenix.Component.form/1` and requires a `for` source plus an
  # inner block; it derives a stable id from the form, so the smoke test supplies a
  # built form rather than relying on introspection.
  defp form_source do
    Phoenix.Component.to_form(%{"email" => ""}, as: :user)
  end

  describe "form/1" do
    test "renders a form element wrapping its inner block" do
      assigns = %{for: form_source()}

      html =
        rendered_to_string(~H"""
        <Form.form for={@for}>Pulsar</Form.form>
        """)

      assert html =~ "<form"
      assert html =~ "Pulsar"
    end

    test "exposes the form struct via :let" do
      assigns = %{for: form_source()}

      html =
        rendered_to_string(~H"""
        <Form.form :let={f} for={@for}>
          {f[:email].name}
        </Form.form>
        """)

      assert html =~ "<form"
      assert html =~ "user[email]"
    end

    test "ships a default vertical rhythm and merges a caller class" do
      assigns = %{for: form_source()}

      html =
        rendered_to_string(~H"""
        <Form.form for={@for} class="max-w-md">Pulsar</Form.form>
        """)

      assert html =~ "space-y-6"
      assert html =~ "max-w-md"
    end

    test "renders required_legend true and false" do
      for value <- [true, false] do
        assigns = %{for: form_source(), value: value}

        html =
          rendered_to_string(~H"""
          <Form.form for={@for} required_legend={@value}>Pulsar</Form.form>
          """)

        assert html =~ "<form"

        if value do
          assert html =~ "indicates a required field"
          # The legend explains a glyph assistive tech never encounters, so it is
          # hidden from the accessibility tree rather than announced.
          assert html =~ ~s(aria-hidden="true")
        else
          refute html =~ "indicates a required field"
        end
      end
    end

    test "required_legend_text overrides the legend copy" do
      assigns = %{for: form_source()}

      html =
        rendered_to_string(~H"""
        <Form.form for={@for} required_legend required_legend_text="champ obligatoire">
          Pulsar
        </Form.form>
        """)

      assert html =~ "champ obligatoire"
      refute html =~ "indicates a required field"
    end
  end
end
