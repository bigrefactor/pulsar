defmodule <%= @component_namespace %>.SwitchTest do
  use ExUnit.Case, async: true

  import Phoenix.LiveViewTest
  import Phoenix.Component

  alias <%= @component_namespace %>.Switch

  # `switch` renders a checkbox input (role="switch") bound to a Phoenix form field,
  # so the smoke test supplies one rather than relying on introspection.
  defp form_field do
    Phoenix.Component.to_form(%{"notifications" => "true"}, as: :user)[:notifications]
  end

  describe "switch/1" do
    test "renders a switch bound to a form field" do
      assigns = %{field: form_field()}
      html = rendered_to_string(~H"<Switch.switch field={@field} />")
      assert html =~ ~s(type="checkbox")
      assert html =~ ~s(role="switch")
      assert html =~ ~s(name="user[notifications]")
    end

    test "renders every variant" do
      for variant <- ~w(solid outline ghost) do
        assigns = %{field: form_field(), variant: variant}
        html = rendered_to_string(~H"<Switch.switch field={@field} variant={@variant} />")
        assert html =~ ~s(role="switch")
      end
    end

    test "renders every color" do
      for color <- ~w(neutral primary secondary success danger warning info) do
        assigns = %{field: form_field(), color: color}
        html = rendered_to_string(~H"<Switch.switch field={@field} color={@color} />")
        assert html =~ ~s(role="switch")
      end
    end

    test "renders every size" do
      for size <- ~w(xs sm md lg xl) do
        assigns = %{field: form_field(), size: size}
        html = rendered_to_string(~H"<Switch.switch field={@field} size={@size} />")
        assert html =~ ~s(role="switch")
      end
    end

    test "a bound switch derives aria-checked from the field value" do
      on = Phoenix.Component.to_form(%{"notifications" => "true"}, as: :user)[:notifications]
      off = Phoenix.Component.to_form(%{"notifications" => "false"}, as: :user)[:notifications]

      assigns = %{field: on}
      assert rendered_to_string(~H"<Switch.switch field={@field} />") =~ ~s(aria-checked="true")

      assigns = %{field: off}
      assert rendered_to_string(~H"<Switch.switch field={@field} />") =~ ~s(aria-checked="false")
    end

    test "an unbound switch reflects the checked attr" do
      for value <- [true, false] do
        assigns = %{value: value}

        html =
          rendered_to_string(~H|<Switch.switch name="notifications" checked={@value} />|)

        assert html =~ ~s(aria-checked="#{value}")
      end
    end

    test "an explicit checked attr overrides the bound field in both directions" do
      on = Phoenix.Component.to_form(%{"notifications" => "true"}, as: :user)[:notifications]
      off = Phoenix.Component.to_form(%{"notifications" => "false"}, as: :user)[:notifications]

      for {field, override} <- [{on, false}, {off, true}] do
        assigns = %{field: field, override: override}

        html =
          rendered_to_string(~H"<Switch.switch field={@field} checked={@override} />")

        assert html =~ ~s(aria-checked="#{override}")
      end
    end

    test "renders disabled, required and invalid true and false" do
      for value <- [true, false] do
        assigns = %{field: form_field(), value: value}

        html =
          rendered_to_string(~H"""
          <Switch.switch field={@field} disabled={@value} required={@value} invalid={@value} />
          """)

        assert html =~ ~s(role="switch")

        if value do
          assert html =~ ~s(aria-invalid="true")
          assert html =~ "required"
        else
          refute html =~ "aria-invalid"
        end
      end
    end

    test "renders loading and show_loading_spinner true and false" do
      for value <- [true, false] do
        assigns = %{field: form_field(), value: value}

        html =
          rendered_to_string(~H"""
          <Switch.switch field={@field} loading={@value} show_loading_spinner={@value} />
          """)

        assert html =~ ~s(role="switch")
      end
    end

    test "render_hidden emits an unchecked companion input" do
      for value <- [true, false] do
        assigns = %{field: form_field(), value: value}
        html = rendered_to_string(~H"<Switch.switch field={@field} render_hidden={@value} />")

        if value do
          assert html =~ ~s(type="hidden")
        else
          refute html =~ ~s(type="hidden")
        end
      end
    end
  end
end
